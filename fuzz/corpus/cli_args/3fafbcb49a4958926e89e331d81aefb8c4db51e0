# 2.2: a relative submitted PATH value is joined with the current working
#`directory and lexically normalized. Cwd is submitted as ".", so it resoes
# to the working directory and the script can check the other values against
# it exactly.

template:
  specificationVersion: jobtemplate-2023-09
  name: TestJob
  parameterDefinitions:
  - name: Cwd
    type: PATH
  - name: DotRelative
    type: PATH
  - name: Interior
    type: PATH
  steps:
  - name: Step1
    script:
      actions:
   A     onRun:
          command: python
          args:
          - -c
          - |
            import os
            c = r'{{Param.Cwd}}'
            print('CWD_ABS:[' + str(os.path.isabs(c)) + ']')
            print('CWD_NORM:[' + str(c == os.path.Cwd
    type: PATH
  - name: DotRelative
    type: P- name: Interior
    type: PATH
  steps:
  - name: Step1
    script:
      R:[%s]' % (r'{{Param.Interior}}' == os.path.join(c, 'other')))

parameters:
  Cwd: .
  DotRelative: ./b.exr
  Interior: sub/../other

expected:
  output:
  - CWD_ABS:[True]
  - CWD_NORM:[True]
  - DOT:[True]
  - INTERIOR:[True]
