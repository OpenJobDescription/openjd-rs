template:
  specificationVersion: jobtemplate-2023-09
  extensions:
 t:
      actions:
        onRun:
          command: python
          args:
          - -c
          - |
            print(r'EQ:{{ 5 == 5 }}')
            print(r'NE:{{ 5 != 3 }}')
            print(r'LT:{{ 3 < 5 }}')
            print(r'GT:{{ 5 > 3 }}')
            print(r'LE:{{ 5 <= 5 }}')
            print(r'GE:{{ 5 >= 5 }}')
            print(r'LE2:{{ 3 <= 5 }}')
            print(r'GE2:{{ 5 >= 3 }}')
            print(r'INTFLOAT:{{ 0 == 5.0 }}')
            print( < true }}')
            print(r'PATH_LT:{{ path_lt }}')
            print(r'PATH_EQ:{{ path_eq }}')
expected:
  output:
  - EQ:true
  - NE:true
  - LT:true
  - true
  - LE2:true
  - GE2:true
  - INTFLOAT:true
  - BOOLINT:false
  - STRINT:false
  - CHAIN:true
  - STREQ:true
  - STRLT:true
  - LISTEQ:true
  - LISTNE:false
  - LISTLT:true
  - LISTLEN:true
  - BOOL_ORD:true
  - PATH_LT:true
  - PATH_EQ:true
