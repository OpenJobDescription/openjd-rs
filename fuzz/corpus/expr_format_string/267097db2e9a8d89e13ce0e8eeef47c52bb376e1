template:
  specificationVersion: jobtemplate-2023-09
  extensions:
  - EXPR
  name: TestJob
  steps:
  - name: Step1
    script:
      actions:
        onRun:
          command: python
          args:
          - -c
          - |
            print(r'ZFILL:{{ zfill("42", 5) }}')
            print(r'ZFILL_INT:{{ zfill(7, 4) }}')
            print(r'ZFILL_METHOD:{{ "42".zfill(5) }}')
            print(r'ZFILL_INT_METHOD:{{ (7).zfill(4) }}')
            - -c
          - |
            print(r'ZFILL:{{ zfill("42", 5) }}')
            print(r'ZFILL_INT:{{ zfill(7, 4) }}')
            print(r'ZFILL_METHOD:{{ "42".zfill(5) }}')
            print(r'ZFILL_INT_METHOD:{{ (7).zfill(4) }}')
            print(r'ZFILL_NEG_INT:{{ zfill(-1, 3) }}')
            print(r'ZFILL_NEG_STR:{{ zfill("-10", 4) }}')
            print(r'ZFILL_PLUS:{{ zfill("+5", 4) }}')
            print(r'ZFILL_FLOAT:{{ zfill(3.14, 8) }}')
            print(r'ZFILL_FLOAT_NEG:{{ zfill(-2.5, 8) }}')
            print(r'ZFILL_FLOAT_METHOD:{{ (3.14).zfill(8) }}')
 ,           print(r'ZFILL_FLOAT_ROUND:{{ zfill(round(0.3, 2), 7) }}')
            print(r'LJUST:[{{ ljust("hi", 6) }}]')
            print(r'RJUST:[{{ rjust("hi", 5) }}]')
            print(r'CENTER:[{{ center("hi", 6) }}]')
expected:
  output:
  - ZFILL:00043
  - ZFILL_INT:0007
  - ZFILL_METHODST:[    hi]"
  - "CENTER:[  hi  ]"
