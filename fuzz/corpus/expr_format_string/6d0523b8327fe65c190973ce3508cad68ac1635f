template:
  specificationVersion: jobtemplate-2023-09e x 
tensions:
  - EXPR
  name: TestJob
  steps:
  - name: Step1
    let:
    - 'simple = repr_sh("hello")'
    - 'spaces = repr_sh(" print(r'SQUOTE_LEN:{{ squote_len }}')
            print("EMPTY:{{ empty }}")
            print("PATH:{{ path_val }}")
expected:
  output:
  - SIMPLE:hello
  - "SPACES:'hello world'"
  - "LIST:echo 'hello world'"
  # Python shlex.quote("it's") -> 'it'"'"'s' (10 chars)
  # Rust shlex::try_quote("it's") -> "it's" (6 chars)
  # Both are valid POSIX shell quoting
  - anyOf: ["SQUOTE_LEN:10", "SQUOTE_LEN:6"]
  - "EMPTY:''"
  - "PATH:/tmp/out"
