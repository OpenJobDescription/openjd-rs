            print(r'CARET:{{ caret }}')
            print(r'ANGLES:{{ angles }}')
            print(r'DQUOTE:{{ dquote }}')
            print(r'PARENS:{{ parens }}')
            print(r'PCT:{{ pct }}')

            print(r'BANG:{{ bang }}')
            print(r'BANG_VAR:{{ bang_var }}')
            
  - "SPACES:\"hello world\""
  - "NEWLINE_STRIPPED:ab"
