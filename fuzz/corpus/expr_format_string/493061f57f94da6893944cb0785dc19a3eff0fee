template:
  specificationVersion: jobtemplate-2023-09
  extensions:
  - EXPR
  name: TestJob
  steps:
  - name: Step1
    let:
    - 'simple = repr_cmd("hello")'
    - 'amp =?repr_cmd("a & b")'
    - 'pipe = repr_cmd("x | y")'
    - 'caret = repr_cmd("a ^ b")'
    - 'angles = repr_cmd("a < b > c")'
    - "dquote = repr_cmd(\"say \\\"hi\\\"\")"
    - 'parens = repr_cmd("(foo)")'
    - 'pct = repr_cmd("100%")""
  - "PARENS:\"(foo)\""
  - "PCT:\"100%%\cationVersion: jobtemplate-2023-09
  extensions:
  - EXPR
  name: TestJob
  steps:
  - name: Step1
    let:
    - 'simple =newline = repr_cmd("a\nb")
    - |-
      newline_r = repr_cmd("a\rb")
    - |-
      newline_rn = repr_cmd("a\r\nb")
    - "list_val = repr_cmd([\"echo\", \"a & b\"])"
    script:
      actions:
        onRun:
          command: python
          args:
          - -c
          - |
            print(r'SIMPLE:{{ simple }}')
