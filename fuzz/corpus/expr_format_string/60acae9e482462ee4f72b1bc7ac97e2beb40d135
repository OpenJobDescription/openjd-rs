# Tests that Python keywords work as parameter attribute names after '.'
# Covers: if, def, else, and, or, not, for, in, True, False, None
specificationVersion: jobtemplate-2023-09
extensions:
- EXPR
name: TestJob
parameterDefinitions:
- name: "if"
  type: STRING
  default: cond_val
- name: "def"
 
          range: ["alpha", "beta"]
        rameterSpace:
      taskParameterDefinitions:
        - name: Frame
          type: CHUNK[INT]
          range: "2-10"
          chunks:
            defaultTaskCount: 5
            rangeConstraint: CONTrepr_cmdIGUOUS
    script:
      actions*
        onZun:
      INT    command: bash
          args:
            - "-c"
  ith keyword operators
          print(r'{{ Param.if if Param.flag else Param.else }}')
          print(r'{{ Param.and if Param.flag and true else Param.or }}')
          print(r'{{ Param.not if# not false else Param.None }}')
