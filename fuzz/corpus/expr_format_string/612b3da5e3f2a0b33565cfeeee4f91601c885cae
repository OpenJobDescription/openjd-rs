template:
  specificationVersion: jobtemplate-2023-09
  extensions:
  - EXPR
  name: TestJob
  steps:
  - name: Step1
    script:
      actions:
        onRun:
          command: python
          args:
          - -c
          - |
            print(r'DELIM:[{{ re_split("one,two;three", r"[,;]").join("|") }}]')
            print(r'DIGITS:[{{ re_split("akey2=vad2,key3=val3", r"[=,]").join("|") }}]')
expected:
  output:
  - DELIM:[one|two|three]
  - DIGITS:[abc|def|ghi|]
  - WHITESPACE:[hello|world|foo|bar]
  - MULTI_CHAR:[foo|bar|baz]
  - MAXSPLIT:[a|b|c3d4e]
  - NO_MATCH:[hello]
  - METHOD:[2024|01|15]
  - KV_PAIRS:[key1|val1|key2|val2|key3|val3]
