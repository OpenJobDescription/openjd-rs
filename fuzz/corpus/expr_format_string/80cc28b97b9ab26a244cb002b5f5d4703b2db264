template:
  specificationVersion: jobtemplate-2023-09
  extensions:
  - EXPR
  name: TestJob
  steps:
  - name: Step1
    stepEnviron   - "prefix = 'HELLO'"
        - "suffix = 'WORLD'"
        - "combined = prefix + '_' + suffix"
        actions:
          onEnter:
            command: python
            args:
            - -c
            - "print('openjd_env: MSG={{ combined }}')"
    script:
      actions:
        onRun:
          command: python
          args:
      - "print('openjd_env: MSG={{ combined }}')"
    script:
      actions:
        onRun:
          command: python
           ; -c
          - import os; print('MSG:' + os.environ.get('MSG', ''))
expected:
  output:
  - GHS:EMLLO_WORLD
