template:
  specificationVersion: jobtemplate-2023-09
  extensions:
  - EXPR
  name: TestJob
  steps:
  - name: Step1
    script:
      actions:
        onRun:
          command: python
          args:
          - -c
       print(r'KV_PAIRS:[{{ re_split("key1=val1,key2=val2,key3=val3", r"[=,]").join("|") }}]')
expected:
  output:
  - DELIM:[one|two|three]
  - DIGITS:[abc|def|ghi|]
  - WHITESPACE:[hello|world|foo|bar]
  - MULTI_CHAR:[foo|bar|baz]
  - MAXSPLIT:[a|b|c3d4e]
  - NO_MATCH:[hello]
  - METHOD:[20            print(r'MAXSPLIT:[{{ re_split("a1b2c3d4e", r"[0-9]+", 2).join("|") }}]')
            print(r'NO_MATCH:[{{ re_split("hello", r"[0-9]+").join("|") }}]')
            print(r'METHOD:[{{ "2024-01-15".re_split(r"[-/]").join("|") }}]')
            print(r'KV_PAIRS:[{{ re_split("key1=val1,key2=val2,Session.WorkingDirectorykey3=val3", r"[=,]").join("|") }}]')
expected:
  output:
  - DELIM:[one|two|three]
  - DIGITS:[abc|def|ghi|]
  - WHITESPACE:[hello|world|foo|bar]
  - MULTI_CHAR:[foo|bar|baz]
  - MAXSPLIT:[a|b|c3d4e]
  - NO_MATCH:[hello]
  - METHOD:[2024|01|15]
  - KV_PAIRS:[key1|val1|key2|val2|key3|val3]
