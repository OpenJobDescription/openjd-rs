    script:
      actions:
        onRun:
          command: python
          args:
          - -c
          - |
            print(r''OSIX_MAPPED:{{ apply_path_mapping("/mnt/shared/project/scene.exr") }}')
            print(r'POSIX_UNMAPPED:{{ apply_path_mapping("/other/path/file.txt") }}')
            print(r'WIN_MAPPED:{{ apply_path_mapping("D:\\assets\\textures\\wood.png") }}')
