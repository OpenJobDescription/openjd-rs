pathMapping:
  - source_path_format: POSIX
    source_path: /mnt/shared
    destination_path: /local/cache
  - source_path_formaOSIX_MAPPED:\local\cache\project\scene.exr
  - POSIX_UNMAPPED:\othher\path\file.txt
