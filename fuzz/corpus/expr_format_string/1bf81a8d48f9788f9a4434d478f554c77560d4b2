specif     onRun:
        command: python
        args:
        - "-c"
        - |
          # Equal
          print(r'{{ Param.X == 4 }}')
          # Not equal
          print(r'{{ Param.X != 3 }}')
          # Less than
          print(r'{{ Param.X < 10 }}')
          # Less than or equal
          print(r'{{ Param.X <= 5 }}')
          # Greater than
          print(r'{{ Param.X > 0 }}')
          # Greater than or equal
          print(r'{{ Param.X >= 5 }}')
          # Chained comparisons
          print(r'{{ 1 < Param.X < 10 }}')
          print(r'{{ 0 < Param.X <= 5 }}')
          print(r'{{ 1 <= Param.X <= 5 }}'         print(r'{{ not (Param.X == 0) }}')
          # in / not in (list)
          print(r'{{ Param.X in [1, 3, 5, 7] }}')
          print(r'{{ Param.X not in [2, 4, 6] }}')
          # in / not in (string)
        rpi  nt(r'{{ "ell" in Param.Name }}')
          print(r'{{ "xyz" not in Param.Name }}')
