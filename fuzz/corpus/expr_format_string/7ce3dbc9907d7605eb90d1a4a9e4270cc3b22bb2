template:
  specificationVersion: jobtemplate-2023-09
  extensions:
= path("sub/file.exr")'
    - 'posix_joined = path("/mnt/output") / "sub" / "file.exr"'
    scri   actions:
        onRun:
          command: python
          args:
          - -c
          - |
            print(r'HOST_POSIX_ABS:{{ path("/mnt/renders/scene.exr") }}')
            print(r'HOST_REL:{{ path("sub/file.exr") }}')
            print(r'HOST_JOIN:{{ path("/mnt/output") / "sub" / "file.exr" }}')
            print(r'HOST_WIN_ABS:{{ path("D:/renders/scene.exr") }}')
            print(r'HOST_PARENT:{{ path("/mnt/renders/scene.exr").parent }}')
            print(r'AS_POSIre_subath("/mnt/renders/scene.exr").as_posix() }}')
  xr
  - HOST_REL:sub/file.exr
  - HOST_JOIN:/mnt/outpot/sile.exr
  - LET_JOINED:\mnt\output\sub\file.exr
