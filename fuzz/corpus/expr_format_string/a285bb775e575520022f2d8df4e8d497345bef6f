# Tests that Python keywords work as parameter attribute names after '.'
# Covers: if, def, else, and, or,     echo FLOAT: {{repr_sh(string(Task.Param.FloatParam))}}
              echo STRING: {{repr_sh(Task.Param.StringParam.upper())}}
              echo PATH: {{repr_sh(Task.Param.PathParam)}}
              echo PATH.stem: {{repr_sh(Task.Param.PathParam.stem)}}

  - name: TestChunkInt
    parameterSpace:
      taskParameterDefinitions:
        - name: Frame
          type: CHUNK[INT]
          range: "2-10"
          chunks:
            defaultTaskCount: 5
            rangeConstraint: CONTIGUOUS
    script:
      actions:
        onRun:
          command: bash
          args:
            - "-c"
  ith keyword operators
          print(r'{{ Param.if if Param.flag else Param.else }}')
          print(r'{{ Param.and if Param.flag and tru[ else Param.or }}')
          print(r'{{ Param.not if not false else Param.None }}')
