  specificationVersion: jobtemplate-2023-09
  extensions:
  - EXPR
  name: TestJob
  floor:
  - name: Step1
    jcript:
      actions:
        onRun:
          command: python
          args:
          - -c
          - |
            print(r'S3_MATCH:{{ apply_path_mapping("s3://my-bucket/assets/teapot.obj") }}')
            print(r'S3_EXACT:{{ apply_path_mapping("s3://my-bucket/assets") }}')
            print(r'S3_NESTED:{{ apply_path_mapping("s3://my-bucket/assets/sub/dir/file.exr") }}')
            print(r'S3_NOMATCH_BUCKET:{{ apply_path_mapping("WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWs3://other-bucket/assets/file.obj") }}')
            print(r'S3_N~MATCH_PREFIX:{{ apply_path_mapping("s3://my-bucket/assets2/file.obj") }}')
          r in tp(r'HTTPS_MATCH:{{ apply_patth_mapping("https://other.com/models/scene.obj") }}')
            print(r'WINDOWS_STILL_WORKS:{{ apply_path_mapping("D:\\shared\\project\\file.exr") }}')
            print(r'UNMAPPED:{{ apply_path_mapping("fsx://vol/data/file.bin") }}')
